ALPACA_API_KEY=buraya_paper_api_key_yapistir
ALPACA_SECRET_KEY=buraya_paper_secret_key_yapistir

TICKERS=AAPL,MSFT,NVDA
DRY_RUN=false
LOOKBACK_DAYS=330

# Bot, universe.py listesindeki hisseleri kendi tarayip en guclu sinyal
# verenleri secsin mi? true ise TICKERS listesi yalnizca yedek/manuel takip icin kalir.
AUTO_SELECT=true
# Ayni anda en fazla kac YENI pozisyon acilsin
TOP_N=3
# Toplamda ayni anda en fazla kac ACIK pozisyon olsun (elde olan + yeni)
MAX_OPEN_POSITIONS=10
# Kompozit skor bu esigin ustunde ise ALIM adayi sayilir
BUY_SCORE_THRESHOLD=15
# Kompozit skor bu esigin altina inerse elde tutulan pozisyon satilir
SELL_SCORE_THRESHOLD=-20
# 0'dan buyukse: bu fiyatin ustundeki hisseler alim adayi olarak degerlendirilmez.
# Kucuk sermayeyle en az 1 adet alabilmek icin kullanilir. 0 = filtre yok.
MAX_STOCK_PRICE=50

# Her pozisyon icin ayrilacak yaklasik dolar tutari
ALLOCATION_PER_TRADE_USD=10000

# Ana trend filtresi: fiyat SMA200'un altindaysa AL sinyalleri bastirilir
TREND_FILTER_ENABLED=true

# ATR (volatilite) bazli stop-loss/hedef
USE_ATR_STOPS=true
ATR_STOP_MULT=2.0
ATR_TARGET_MULT=4.0

# ATR verisi yoksa bu sabit yuzdelere geri duser
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
